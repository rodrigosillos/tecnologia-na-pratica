{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tnp:chapter8:request:1.0",
  "description": "Structural wire contract. Additional cross-field and stream rules are enforced by contract.py and client.py.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "language": {
      "enum": [
        "pt-BR",
        "en-US"
      ]
    },
    "queries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        },
        "required": [
          "id",
          "text"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "language",
    "queries"
  ],
  "additionalProperties": false
}